# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────

# PostgreSQL connection string for NextAuth session/user/account tables.
DATABASE_URL=""

# Auth secret — generate with: npx auth secret --copy
AUTH_SECRET=""

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for non-Vercel deploys (Kessel, Railway, etc.)
AUTH_TRUST_HOST="true"

# Domain restriction — only accounts from this domain can sign in.
AUTH_ALLOWED_EMAIL_DOMAIN="mindvalley.com"

# Dev-only: bypass Google OAuth for local testing (NODE_ENV=development only).
# Set to any @mindvalley.com email. Ignored in production.
MOCK_SESSION_EMAIL=""

# ── Airtable ─────────────────────────────────────────────────────────────────

AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""

# OKTA Employee Sync base — sign-in allowlist (currently-employed staff only).
# The AIRTABLE_API_KEY PAT must be granted read access on this base.
OKTA_AIRTABLE_BASE_ID="appf6GMygLkV4tYZi"
OKTA_AIRTABLE_TABLE_ID="tbldC9kS9k8xziNGH"
